{
  // Deploys Kata as a Cloudflare Worker with static assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kata",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
