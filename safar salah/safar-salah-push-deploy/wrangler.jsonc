{
  // Safar Salah: app + prayer-time push notifications on Cloudflare Workers
  "name": "safar-salah",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "safarsalahapp.com", "custom_domain": true },
    { "pattern": "www.safarsalahapp.com", "custom_domain": true }
  ],
  // the website files
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // where push subscriptions are stored  >>> replace the id with your KV namespace ID <<<
  "kv_namespaces": [
    { "binding": "SUBS", "id": "PASTE_YOUR_KV_ID_HERE" }
  ],
  // check every minute for prayer times that are due
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "VAPID_PUBLIC": "BO9uoyS0m1xtOjZcpQ37V2jClzhPtz7zYYVzcyJVUWS4jSyHDrkIbkXT9WSSZF-I-vC70iO5HbyV1ktotAapR-Y",
    "VAPID_SUBJECT": "mailto:safarsalahapp@gmail.com"
  },
  // the private key is NOT here: add it in Cloudflare as a secret named VAPID_PRIVATE_JWK
  "observability": { "enabled": true }
}
